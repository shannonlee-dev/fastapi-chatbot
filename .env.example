# 로컬 개발 설정입니다. .env로 복사하고 실제 값을 입력합니다.
DATABASE_URL=sqlite:///./data/chatbot.db
SESSION_SECRET=

# 로컬에서 채팅을 사용할 때 주석을 해제하고 키를 입력합니다.
# OPENAI_API_KEY=

OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=30
APP_ENV=local
LOG_LEVEL=INFO
ADMIN_USERNAME=admin

# 관리자 계정이 없는 DB의 첫 실행 시 필요합니다.
# ADMIN_INITIAL_PASSWORD=

PORT=
